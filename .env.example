# Optional for unattended simulation only; prefer the interactive passphrase prompt.
# DERO_CHAT_PASSPHRASE=use-a-long-unique-passphrase
# Wallet credentials are separate from the application passphrase.
# DERO_WALLET_USER=alice
# DERO_WALLET_PASSWORD=replace-me

# Optional separate credentials for the user-managed Mainnet probe Wallet RPCs.
# Supply securely in the local environment; never commit real values.
# DERO_ALICE_RPC_USER=alice
# DERO_ALICE_RPC_PASSWORD=replace-me
# DERO_BOB_RPC_USER=bob
# DERO_BOB_RPC_PASSWORD=replace-me
